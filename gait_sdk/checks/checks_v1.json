    "CHK.FASTAPI.HTTPS_REDIRECT": {
      "pack": "fastapi",
      "severity": "MEDIUM",
      "env_gated": true,
      "valid_for_seconds": 604800,
      "title": "HTTP is redirected to HTTPS",
      "remediation": "Add HTTPSRedirectMiddleware, or confirm your proxy or load balancer redirects HTTP to HTTPS.",
      "facts": {
        "https_redirect_installed": {
          "type": "bool"
        }
      }
    },
    "CHK.DEPS.KNOWN_VULNS": {
      "pack": "deps",
      "severity": "HIGH",
      "env_gated": false,
      "valid_for_seconds": 172800,
      "title": "No known-vulnerable Python packages",
      "remediation": "Upgrade each listed package to its fixed version (pip install -U <package>) and redeploy; for advisories with no fix yet, check the advisory for a workaround.",
      "facts": {
        "tool": {
          "type": "enum",
          "values": [
            "pip-audit",
            "osv-scanner",
            "none"
          ]
        },
        "reason": {
          "type": "enum",
          "values": [
            "tool_missing",
            "timeout",
            "unparseable",
            "network"
          ]
        },
        "vulnerable_count": {
          "type": "int",
          "min": 0,
          "max": 10000
        },
        "unfixed_count": {
          "type": "int",
          "min": 0,
          "max": 10000
        },
        "items": {
          "type": "list_record",
          "max_items": 10,
          "required": [
            "package",
            "version",
            "advisory_id"
          ],
          "fields": {
            "package": {
              "type": "pattern",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            },
            "version": {
              "type": "pattern",
              "pattern": "^[0-9A-Za-z.+!-]{1,50}$"
            },
            "advisory_id": {
              "type": "pattern",
              "pattern": "^(PYSEC|GHSA|CVE|OSV)-[A-Za-z0-9-]{1,40}$"
            },
            "fixed_in": {
              "type": "pattern",
              "pattern": "^[0-9A-Za-z.+!-]{1,50}$"
            }
          }
        }
      }
    }
