          "type": "bool"
        },
        "tls": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.FASTAPI.DEBUG_OFF": {
      "pack": "fastapi",
      "severity": "HIGH",
      "env_gated": true,
      "valid_for_seconds": 604800,
      "title": "FastAPI debug mode is off",
      "remediation": "Create the app with FastAPI(debug=False) in every deployed environment (read the flag from the environment, default False).",
      "facts": {
        "debug": {
          "type": "bool"
        }
      }
    },
    "CHK.FASTAPI.DOCS_HIDDEN": {
      "pack": "fastapi",
      "severity": "LOW",
      "env_gated": true,
      "valid_for_seconds": 604800,
      "title": "API docs aren't public in production",
      "remediation": "In production pass docs_url=None, redoc_url=None and openapi_url=None to FastAPI(), or put the docs behind authentication.",
      "facts": {
        "docs_url_set": {
          "type": "bool"
        },
        "redoc_url_set": {
          "type": "bool"
        },
        "openapi_url_set": {
          "type": "bool"
        }
      }
    },
    "CHK.FASTAPI.CORS_NOT_WILDCARD": {
      "pack": "fastapi",
      "severity": "HIGH",
      "env_gated": false,
      "valid_for_seconds": 604800,
      "title": "CORS isn't open to every origin",
      "remediation": "List exact origins in CORSMiddleware(allow_origins=[...]); don't combine '*' or a catch-all allow_origin_regex with allow_credentials=True.",
      "facts": {
        "cors_installed": {
          "type": "bool"
        },
        "allow_all": {
          "type": "bool"
        },
        "catch_all_regex": {
          "type": "bool"
        },
        "allow_credentials": {
          "type": "bool"
        }
      }
    },
    "CHK.FASTAPI.TRUSTED_HOST": {
      "pack": "fastapi",
      "severity": "MEDIUM",
      "env_gated": true,
      "valid_for_seconds": 604800,
      "title": "Requests are limited to your own host names",
      "remediation": "Add TrustedHostMiddleware(allowed_hosts=[...]) with your real host names, without '*'.",
      "facts": {
        "trusted_host_installed": {
          "type": "bool"
        },
        "wildcard": {
          "type": "bool"
        }
      }
