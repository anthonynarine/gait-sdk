    "CHK.DJANGO.PASSWORD_POLICY": {
      "pack": "django",
      "severity": "MEDIUM",
      "env_gated": false,
      "title": "Password rules are strong",
      "remediation": "Enable Django's password validators with MinimumLengthValidator min_length >= 12 and CommonPasswordValidator.",
      "facts": {
        "validator_count": {
          "type": "int",
          "min": 0,
          "max": 50
        },
        "min_length": {
          "type": "int",
          "min": 0,
          "max": 1000
        },
        "common_list_check": {
          "type": "bool"
        },
        "numeric_check": {
          "type": "bool"
        },
        "similarity_check": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.DB_TLS": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": true,
      "title": "Database connections use TLS",
      "remediation": "Set OPTIONS sslmode to 'require' (or verify-full) for every network PostgreSQL database.",
      "facts": {
        "network_databases": {
          "type": "int",
          "min": 0,
          "max": 50
        },
        "tls_required": {
          "type": "int",
          "min": 0,
          "max": 50
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.EMAIL_TLS": {
      "pack": "django",
      "severity": "MEDIUM",
      "env_gated": true,
      "title": "Outgoing email uses TLS",
      "remediation": "With the SMTP backend, set EMAIL_USE_TLS = True (port 587) or EMAIL_USE_SSL = True (port 465).",
      "facts": {
