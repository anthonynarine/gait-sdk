{
  "schema_version": 1,
  "outcomes": [
    "ok",
    "fail",
    "weak",
    "not_applicable",
    "unknown",
    "error"
  ],
  "outcome_results": {
    "ok": "PASS",
    "fail": "FAIL",
    "weak": "WARNING",
    "not_applicable": "INFORMATIONAL",
    "unknown": "INFORMATIONAL",
    "error": "INFORMATIONAL"
  },
  "common_facts": {
    "django_ids": {
      "type": "list_pattern",
      "pattern": "^[a-z_]{1,20}\\.[EW][0-9]{3}$",
      "max_items": 25
    }
  },
  "limits": {
    "max_payload_bytes": 4096,
    "max_total_keys": 100,
    "max_list_items": 25,
    "source_reference_pattern": "^[A-Za-z0-9:._-]{1,128}$",
    "max_record_items": 10
  },
  "checks": {
    "CHK.DJANGO.DEBUG_OFF": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": true,
      "title": "Django DEBUG is off",
      "remediation": "Set DEBUG = False in every deployed environment (read it from the environment, default False).",
      "facts": {
        "debug": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.ALLOWED_HOSTS": {
      "pack": "django",
      "severity": "MEDIUM",
      "env_gated": true,
      "title": "Django ALLOWED_HOSTS is an explicit allow-list",
      "remediation": "List your real host names in ALLOWED_HOSTS; never use '*'.",
      "facts": {
        "host_count": {
          "type": "int",
          "min": 0,
          "max": 1000
        },
        "wildcard": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.SIGNING_KEY_STRENGTH": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": false,
      "title": "The Django signing key is strong",
      "remediation": "Generate a random signing key of at least 50 characters (e.g. django.core.management.utils.get_random_secret_key), keep it out of source control, and load it from the environment.",
      "facts": {
        "length": {
          "type": "int",
          "min": 0,
          "max": 100000
        },
        "unique_chars": {
          "type": "int",
          "min": 0,
          "max": 100000
        },
        "insecure_prefix": {
          "type": "bool"
        },
        "placeholder": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.SIGNING_KEY_FALLBACKS": {
      "pack": "django",
      "severity": "MEDIUM",
      "env_gated": false,
      "title": "Old Django signing keys are strong and few",
      "remediation": "Keep at most two old signing keys (Django's key fallbacks setting) during a rotation, make each one strong, and remove them once sessions have rolled over.",
      "facts": {
        "fallback_count": {
          "type": "int",
          "min": 0,
          "max": 100
        },
        "weak_fallbacks": {
          "type": "int",
          "min": 0,
          "max": 100
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.DB_CREDENTIALS_SET": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": true,
      "title": "Network databases require credentials",
      "remediation": "Give every network database connection a user and a strong credential loaded from the environment.",
      "facts": {
        "network_databases": {
          "type": "int",
          "min": 0,
          "max": 50
        },
        "missing_credentials": {
          "type": "int",
          "min": 0,
          "max": 50
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.SECURITY_MIDDLEWARE": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": false,
      "title": "Django SecurityMiddleware is enabled",
      "remediation": "Add django.middleware.security.SecurityMiddleware near the top of MIDDLEWARE.",
      "facts": {
        "present": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.CSRF_MIDDLEWARE": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": false,
      "title": "Django CSRF protection is enabled",
      "remediation": "Keep django.middleware.csrf.CsrfViewMiddleware in MIDDLEWARE.",
      "facts": {
        "present": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.CLICKJACKING": {
      "pack": "django",
      "severity": "MEDIUM",
      "env_gated": false,
      "title": "Pages can't be framed by other sites",
      "remediation": "Enable XFrameOptionsMiddleware and set X_FRAME_OPTIONS = 'DENY'.",
      "facts": {
        "middleware_present": {
          "type": "bool"
        },
        "frame_option": {
          "type": "enum",
          "values": [
            "DENY",
            "SAMEORIGIN",
            "unset",
            "other"
          ]
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.SSL_REDIRECT": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": true,
      "title": "HTTP is redirected to HTTPS",
      "remediation": "Set SECURE_SSL_REDIRECT = True (and SECURE_PROXY_SSL_HEADER if you run behind a TLS-terminating proxy).",
      "facts": {
        "ssl_redirect": {
          "type": "bool"
        },
        "proxy_header_set": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.HSTS": {
      "pack": "django",
      "severity": "MEDIUM",
      "env_gated": true,
      "title": "HSTS is set for at least a year",
      "remediation": "Set SECURE_HSTS_SECONDS = 31536000 once HTTPS works everywhere; add includeSubDomains only when every subdomain serves HTTPS.",
      "facts": {
        "hsts_seconds": {
          "type": "int",
          "min": 0,
          "max": 1000000000
        },
        "include_subdomains": {
          "type": "bool"
        },
        "preload": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.NOSNIFF": {
      "pack": "django",
      "severity": "LOW",
      "env_gated": false,
      "title": "Browsers don't guess content types",
      "remediation": "Set SECURE_CONTENT_TYPE_NOSNIFF = True.",
      "facts": {
        "nosniff": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.SESSION_COOKIE_FLAGS": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": true,
      "title": "Session cookies are Secure and HttpOnly",
