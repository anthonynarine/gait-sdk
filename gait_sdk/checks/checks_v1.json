      "facts": {
        "csrf_secure": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.REFERRER_POLICY": {
      "pack": "django",
      "severity": "LOW",
      "env_gated": false,
      "title": "A referrer policy is set",
      "remediation": "Set SECURE_REFERRER_POLICY = 'same-origin' (or 'strict-origin-when-cross-origin').",
      "facts": {
        "policy": {
          "type": "enum",
          "values": [
            "no-referrer",
            "no-referrer-when-downgrade",
            "origin",
            "origin-when-cross-origin",
            "same-origin",
            "strict-origin",
            "strict-origin-when-cross-origin",
            "unsafe-url",
            "unset",
            "other"
          ]
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.COOP": {
      "pack": "django",
      "severity": "LOW",
      "env_gated": false,
      "title": "A cross-origin opener policy is set",
      "remediation": "Set SECURE_CROSS_ORIGIN_OPENER_POLICY = 'same-origin'.",
      "facts": {
        "policy": {
          "type": "enum",
          "values": [
            "same-origin",
            "same-origin-allow-popups",
            "unsafe-none",
            "unset",
            "other"
          ]
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.CORS_NOT_WILDCARD": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": false,
      "title": "CORS isn't open to every origin",
      "remediation": "List exact origins in CORS_ALLOWED_ORIGINS; don't combine CORS_ALLOW_ALL_ORIGINS or a catch-all regex with credentials.",
      "facts": {
        "cors_installed": {
          "type": "bool"
        },
        "allow_all": {
          "type": "bool"
        },
        "catch_all_regex": {
          "type": "bool"
        },
        "allow_credentials": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.ADMIN_URL": {
      "pack": "django",
      "severity": "LOW",
      "env_gated": false,
      "title": "The Django admin isn't at /admin/",
      "remediation": "Mount the admin at a less guessable path (this only reduces noise; the admin still needs strong sign-in).",
      "facts": {
        "admin_installed": {
          "type": "bool"
        },
        "default_path": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.DRF_DEFAULT_DENY": {
      "pack": "django",
      "severity": "HIGH",
      "env_gated": false,
      "title": "Django REST framework denies by default",
      "remediation": "Set REST_FRAMEWORK['DEFAULT_PERMISSION_CLASSES'] to IsAuthenticated (or stricter) and open endpoints one by one.",
      "facts": {
        "drf_installed": {
          "type": "bool"
        },
        "classes_set": {
          "type": "bool"
        },
        "default_allow_any": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
