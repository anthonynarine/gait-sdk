      "facts": {
        "session_secure": {
          "type": "bool"
        },
        "session_httponly": {
          "type": "bool"
        }
      },
      "valid_for_seconds": 604800
    },
    "CHK.DJANGO.CSRF_COOKIE_SECURE": {
      "pack": "django",
      "severity": "MEDIUM",
      "env_gated": true,
      "title": "The CSRF cookie is Secure",
